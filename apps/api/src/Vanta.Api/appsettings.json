{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=vanta;Username=vanta;Password=vanta_dev_only"
  },
  "Jwt": {
    "Issuer": "vanta-api",
    "Audience": "vanta-clients",
    "_comment": "SigningKey below is a local-dev-only placeholder. Override via the Jwt__SigningKey environment variable (or a secret manager) in every non-development environment.",
    "SigningKey": "dev-only-signing-key-change-me-before-any-real-deployment-32chars",
    "ExpirationMinutes": 60
  },
  "Payment": {
    "Provider": "mock"
  },
  "OrderReservations": {
    "ExpirationMinutes": 30
  },
  "WhatsApp": {
    "Provider": "meta",
    "GraphApiBaseUrl": "https://graph.facebook.com/v22.0",
    "PhoneNumberId": "",
    "AccessToken": "",
    "WebhookVerifyToken": "",
    "AppSecret": ""
  },
  "Ai": {
    "Provider": "gemini",
    "ApiKey": "",
    "Model": "gemini-3.6-flash"
  },
  "Commerce": {
    "BaseUrl": "http://localhost:3000",
    "CatalogPath": "/store/{slug}",
    "CheckoutPath": "/checkout/{paymentReference}"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}
