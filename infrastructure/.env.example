# Copy to infrastructure/.env and adjust as needed:
#   cp infrastructure/.env.example infrastructure/.env
#
# docker-compose.yml already has safe mock defaults for everything below, so
# `docker compose up` works without this file. Only create it to opt into real
# WhatsApp/AI providers locally. Never commit infrastructure/.env — it is gitignored.

# A random 32+ character string is enough for local development.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-before-any-real-deployment-32chars

# "mock" (default) needs no credentials. Set to "meta" only with real values below.
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# "mock" (default) needs no credentials. Set to "gemini"/"groq"/"openrouter" only with a real key.
AI_PROVIDER=mock
AI_API_KEY=
